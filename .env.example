# ===================================
# BACKEND (Render) Environment Vars
# ===================================

# Port (Render sets this automatically - do NOT add manually on Render)
# PORT=8081

# Your Vercel frontend URL - used for CORS
CORS_ORIGIN=https://mind-mend-five.vercel.app

# JWT Secret - use a long random string
JWT_SECRET=change_me_to_a_random_64_char_string

# ===================================
# FRONTEND (Vercel) Environment Vars
# ===================================

# Your Render backend URL - set this in Vercel project settings
VITE_API_URL=https://your-mindmend-backend.onrender.com
